[Unit]
Description=BNDS.life Next.js website
After=network.target postgresql.service

[Service]
Type=simple
User=bndslife
Group=bndslife
WorkingDirectory=/srv/bnds-life/current
EnvironmentFile=/srv/bnds-life/shared/.env
ExecStart=/usr/local/bin/node /srv/bnds-life/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
